rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /tables/{tableId} {
      // Lobby info only (code, phase, seat count)
      allow read: if request.auth != null;
      allow write: if false;

      // Each player can read only their own view of the table
      match /views/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // Full state with the deck and every hand. Only the function touches this.
      match /secret/{doc} {
        allow read, write: if false;
      }
    }
  }
}
